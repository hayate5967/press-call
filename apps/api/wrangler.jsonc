// Cloudflare Workers の設定。API と Web アプリを 1 つの Worker から配信する（ADR-007）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "press-call",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Web アプリ（Vite）のビルド結果。/api/* 以外はここから返す
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 環境の名前。手元では .dev.vars の ENVIRONMENT=development がこれを上書きする
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  },
  // Neon の production ブランチへの接続プール。接続文字列は Hyperdrive の設定の中にあり、ID は秘密ではない。
  // キャッシュは無効（保存直後の設定やトークンの状態を古い値で返さないため）。
  // 手元の wrangler dev では、.dev.vars の DATABASE_URL（開発用ブランチ）を使う
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "d6f683940de44d59b909637bafcee24b" }]
}
