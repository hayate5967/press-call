# このファイルを .dev.vars にコピーして値を入れる（.dev.vars は Git に入れない）
# 本番では wrangler secret put <名前> で登録する

# Google OAuth（Google Cloud Console で発行）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT 署名用の ES256 秘密鍵（JWK 形式の JSON を 1 行で）
JWT_PRIVATE_JWK=

# 手元の開発で使う Neon の開発用ブランチの接続文字列
DATABASE_URL=

# 手元の開発環境であることを示す（wrangler.jsonc の production を上書きする）
ENVIRONMENT=development

# 【ステップ3で削除】仮のデバイスの ID。ENVIRONMENT=development のときだけ効く。デバイス向け API はこのデバイスから届いたものとして扱う
# scripts/seed-dev.sql を開発用ブランチに流すと、この ID のユーザーとデバイスができる。本番には登録しない
DEV_DEVICE_ID=00000000-0000-4000-8000-000000000002
