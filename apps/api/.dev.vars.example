# このファイルを .dev.vars にコピーして値を入れる（.dev.vars は Git に入れない）
# 本番では wrangler secret put <名前> で登録する

# Google OAuth（Google Cloud Console で発行）
# 「承認済みのリダイレクト URI」に http://localhost:5173/api/v1/auth/google/callback（手元）と
# https://<Worker のドメイン>/api/v1/auth/google/callback（本番）を登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT 署名用の ES256 秘密鍵（JWK 形式の JSON を 1 行で）。pnpm --filter @press-call/api auth:generate-key で作る
JWT_PRIVATE_JWK=

# 手元の開発で使う Neon の開発用ブランチの接続文字列
DATABASE_URL=

# 手元の開発環境であることを示す（wrangler.jsonc の production を上書きする）
ENVIRONMENT=development


# ブラウザから見たオリジン。Vite（5173 番）経由で開くときに入れる。
# Google のリダイレクト URI・JWT の iss・ペアリングの許可画面の URL に使う（本番では入れない）
PUBLIC_ORIGIN=http://localhost:5173
