{
  "name": "@press-call/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @press-call/web build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "device:issue-token": "tsx scripts/issue-device-token.ts",
    "device:settings": "tsx scripts/set-device-settings.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@press-call/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@electric-sql/pglite": "0.5.16",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
