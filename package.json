{
  "name": "press-call",
  "private": true,
  "description": "ベンチプレスの静止を検知して Press 合図を出し、記録を自動で残すアプリ",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @press-call/api dev",
    "dev:web": "pnpm --filter @press-call/web dev",
    "build": "pnpm -r build",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2"
  }
}
